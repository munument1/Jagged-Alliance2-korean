    <hit>1</hit>
    <target_zombie>1</target_zombie>
  </TAUNT>
  <TAUNT>
    <uiIndex>1</uiIndex>
    <szText>빙고!</szText>
    <hit>1</hit>
  </TAUNT>
  <TAUNT>
    <uiIndex>2</uiIndex>
    <szText>탁월함은 기술이 아니라 태도입니다.</szText>
    <hit>1</hit>
    <brave>1</brave>
  </TAUNT>
  <TAUNT>
    <uiIndex>3</uiIndex>
    <szText>불쌍해라! 피가 나네... 잠깐만, 탐폰 찾아줄게.</szText>

    <aggressive>1</aggressive>
    <hit_blade>1</hit_blade>
  </TAUNT>
  <TAUNT>
    <uiIndex>12</uiIndex>
    <szText>걱정 마세요, 소독 완료됐습니다!</szText>
    <hit_blade>1</hit_blade>
  </TAUNT>
  <TAUNT>

    <hit_blade>1</hit_blade>
    <aggressive>1</aggressive>
  </TAUNT>
  <TAUNT>
    <uiIndex>8</uiIndex>
    <szText>지금 뭐가 좋을 것 같으세요? 파바빈이랑 키안티 와인 한 잔이요!</szText>
    <hit_blade>1</hit_blade>
    <aggressive>1</aggressive>
  </TAUNT>
  <TAUNT>
    <uiIndex>9</uiIndex>
    <szText>싹둑싹둑!</szText>
    <aggressive>1</aggressive>
    <attack_blade>1</attack_blade>
    <hit_blade>1</hit_blade>
  </TAUNT>
  <TAUNT>
    <uiIndex>10</uiIndex>
